# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sakila:p_ssW0rd@localhost:5432/sakila

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AWS Bedrock ───────────────────────────────────────────────
# Credentials use the standard AWS chain (aws configure / aws sso login / env vars / IAM role).
# Do NOT put access keys in this file; set AWS_PROFILE below or export AWS_ACCESS_KEY_ID etc.
# The model must be enabled for your account under Bedrock > Model access.
AWS_REGION=ap-southeast-1
AWS_PROFILE=admin

BEDROCK_MODEL_ID=
# ── Query execution (safety) ──────────────────────────────────
QUERY_TIMEOUT_MS=10000        # server-side statement_timeout for every query
MAX_ROWS=500                  # rows returned to the client (result is flagged truncated beyond this)

# ── Accuracy ──────────────────────────────────────────────────
MAX_ATTEMPTS=3                # generation + self-correction rounds per question
FEWSHOT_TOP_K=4               # curated examples injected into the prompt (+2 for complex questions)
COMPLEX_CANDIDATES=3          # SQL candidates generated for complex questions (majority vote on results)
CANDIDATE_TEMPERATURE=0.7     # sampling temperature for the extra candidates (first one is greedy)

# ── Cache ─────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=1000
SQL_CACHE_TTL_SECONDS=86400   # question -> validated SQL (data is always re-queried, so results stay fresh)
ANSWER_CACHE_TTL_SECONDS=3600 # (question, result) -> natural-language answer
SCHEMA_CACHE_TTL_SECONDS=3600 # introspected schema
CACHE_PERSIST_PATH=data/cache/sql_cache.json   # leave empty to keep the SQL cache in memory only

# ── API ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
