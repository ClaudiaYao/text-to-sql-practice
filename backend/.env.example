# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sakila:p_ssW0rd@localhost:5432/sakila

# ── LLM Provider: "azure" or "vertexai" ───────────────────────
LLM_PROVIDER=azure

# ── Azure AI Foundry / Azure OpenAI ───────────────────────────
# Endpoint format: https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_API_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── GCP Vertex AI (alternative) ───────────────────────────────
# Set LLM_PROVIDER=vertexai and fill these if using Vertex AI
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=us-central1
VERTEXAI_MODEL=gemini-2.0-flash-001
